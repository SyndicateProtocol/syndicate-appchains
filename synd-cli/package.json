{
  "name": "synd-cli",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "synd-cli": "bun run src/cli/index.ts",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check-write": "biome check --write . --files-ignore-unknown=true --no-errors-on-unmatched"
  },
  "dependencies": {
    "@arbitrum/orbit-sdk": "^0.23.3",
    "@arbitrum/sdk": "^4.0.4",
    "@commander-js/extra-typings": "^14.0.0",
    "abitype": "^1.1.1",
    "commander": "^14.0.2",
    "viem": "^2.23.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4.0.7",
    "@types/bun": "^1.2.2",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
